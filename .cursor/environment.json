{
  "name": "Cosmic Analysis",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "streamlit",
      "command": "source .venv/bin/activate && streamlit run app.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true --browser.gatherUsageStats=false",
      "description": "Cosmic Analysis Streamlit dashboard, served on port 8501."
    }
  ],
  "ports": [
    {
      "name": "streamlit",
      "port": 8501
    }
  ]
}
